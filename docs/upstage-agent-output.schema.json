{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrescriptionExtractionResult",
  "description": "처방전 이미지에서 추출한 결과. 백엔드가 이 형태 그대로 프런트에 전달한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviewStatus", "documentType", "medications", "issues"],
  "properties": {
    "reviewStatus": {
      "type": "string",
      "enum": ["ready", "needs_review", "needs_retake", "unsupported_document"],
      "description": "결과를 바로 쓸 수 있는지. 값이 모두 확실하면 ready, 사용자 확인이 필요하면 needs_review, 이미지가 흐리거나 잘려 재촬영이 필요하면 needs_retake, 처방전이 아니면 unsupported_document."
    },
    "documentType": {
      "type": "string",
      "enum": ["patient_copy_prescription", "other"],
      "description": "환자 보관용 처방전이면 patient_copy_prescription, 그 밖의 문서면 other."
    },
    "medications": {
      "type": "array",
      "description": "처방된 약물 목록. 한 건이어도 배열로 담는다. 판독 불가면 빈 배열.",
      "items": { "$ref": "#/$defs/medication" }
    },
    "issues": {
      "type": "array",
      "description": "사용자 확인이 필요한 항목. 없으면 빈 배열.",
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "$defs": {
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "rawText"],
      "properties": {
        "value": { "type": "number", "description": "수치." },
        "unit": { "type": "string", "description": "단위. 예: 정, mg, mL." },
        "rawText": { "type": "string", "description": "처방전에 적힌 원문 그대로. 예: 1정." }
      }
    },
    "evidence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["page", "coordinates", "rawText"],
      "description": "이 값이 처방전의 어디서 나왔는지. 사용자가 원문과 대조할 수 있어야 한다.",
      "properties": {
        "page": { "type": "integer", "description": "1부터 시작하는 페이지 번호." },
        "coordinates": {
          "type": "array",
          "description": "해당 영역을 감싸는 꼭짓점들. 0~1로 정규화된 상대 좌표.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        },
        "rawText": { "type": "string", "description": "그 영역의 원문 텍스트." }
      }
    },
    "extractedString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status", "confidence", "evidence"],
      "properties": {
        "value": { "type": ["string", "null"], "description": "추출한 값. status가 extracted가 아니면 null." },
        "status": {
          "type": "string",
          "enum": ["extracted", "not_present", "unreadable"],
          "description": "읽어냈으면 extracted, 처방전에 애초에 없으면 not_present, 있는데 못 읽었으면 unreadable."
        },
        "confidence": { "type": ["string", "null"], "enum": ["high", "low", null] },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "extractedInteger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status", "confidence", "evidence"],
      "properties": {
        "value": { "type": ["integer", "null"] },
        "status": { "type": "string", "enum": ["extracted", "not_present", "unreadable"] },
        "confidence": { "type": ["string", "null"], "enum": ["high", "low", null] },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "extractedBoolean": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status", "confidence", "evidence"],
      "properties": {
        "value": { "type": ["boolean", "null"] },
        "status": { "type": "string", "enum": ["extracted", "not_present", "unreadable"] },
        "confidence": { "type": ["string", "null"], "enum": ["high", "low", null] },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "extractedQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status", "confidence", "evidence"],
      "properties": {
        "value": {
          "oneOf": [{ "$ref": "#/$defs/quantity" }, { "type": "null" }]
        },
        "status": { "type": "string", "enum": ["extracted", "not_present", "unreadable"] },
        "confidence": { "type": ["string", "null"], "enum": ["high", "low", null] },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "medication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "drugName",
        "printedProductCode",
        "strength",
        "dosageForm",
        "dose",
        "frequencyPerDay",
        "durationDays",
        "timingInstruction",
        "route",
        "asNeeded"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "이 결과 안에서만 유효한 약물 식별자. med_1, med_2 처럼 1부터 매긴다."
        },
        "drugName": { "$ref": "#/$defs/extractedString", "description": "약품명." },
        "printedProductCode": { "$ref": "#/$defs/extractedString", "description": "처방전에 인쇄된 제품 코드." },
        "strength": { "$ref": "#/$defs/extractedQuantity", "description": "함량. 예: 5/50mg." },
        "dosageForm": { "$ref": "#/$defs/extractedString", "description": "제형. 예: 정, 캡슐, 시럽." },
        "dose": { "$ref": "#/$defs/extractedQuantity", "description": "1회 투여량. 예: 1정." },
        "frequencyPerDay": { "$ref": "#/$defs/extractedInteger", "description": "1일 투여 횟수." },
        "durationDays": { "$ref": "#/$defs/extractedInteger", "description": "총 투약 일수." },
        "timingInstruction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "english"],
          "description": "복용 시점 지시.",
          "properties": {
            "source": { "$ref": "#/$defs/extractedString", "description": "처방전에 적힌 원문. 예: 아침 식후 30분." },
            "english": { "type": ["string", "null"], "description": "원문의 영어 번역. 원문은 그대로 두고 번역만 덧붙인다." }
          }
        },
        "route": { "$ref": "#/$defs/extractedString", "description": "투여 경로. 예: 경구, 외용." },
        "asNeeded": { "$ref": "#/$defs/extractedBoolean", "description": "필요 시 복용(PRN) 여부." }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "medicationId", "field", "message", "evidence"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "low_confidence",
            "missing_required_field",
            "unreadable_document",
            "unsupported_document",
            "invalid_agent_output"
          ]
        },
        "medicationId": { "type": ["string", "null"], "description": "관련된 약물의 id. 문서 전체에 대한 문제면 null." },
        "field": { "type": ["string", "null"], "description": "관련된 필드명. 예: durationDays." },
        "message": { "type": "string", "description": "사용자에게 보여줄 한국어 안내 문구." },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
